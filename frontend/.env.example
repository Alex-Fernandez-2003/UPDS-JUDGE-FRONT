# Values exposed to React; do not place secrets here.
VITE_APP_NAME=UPDS Judge
VITE_API_BASE_URL=/api
VITE_REQUEST_TIMEOUT_MS=10000
VITE_ENABLE_MOCKS=false

# Node/Vite tooling only. Confirm the OpenAPI URL before setting it.
API_PROXY_TARGET=http://localhost:5185
OPENAPI_SCHEMA_URL=http://localhost:5185/swagger/v1/swagger.json