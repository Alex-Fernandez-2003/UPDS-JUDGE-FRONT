@startuml
skinparam componentStyle rectangle
package "Repositorio Frontend (arquitectura prevista)" {
  [Aplicación React SPA\nVite + TypeScript] as SPA
  [React Router] as Router
  [Layouts y páginas] as Paginas
  [Componentes reutilizables] as Componentes
  [Cliente API] as ApiClient
  [Cliente SignalR] as SignalClient
}
package "Repositorio Backend (previsto)" {
  [ASP.NET Core MVC / Web API] as Controllers
  [Servicios de aplicación] as Services
  [Acceso a datos EF Core] as EF
  [ASP.NET Core Identity] as Identity
  [Integración Judge0] as J0
  [Hub SignalR] as Hub
  [Worker de evaluación] as Worker
}
database PostgreSQL as DB
cloud Judge0 as Judge
SPA --> Router
Router --> Paginas
Paginas --> Componentes
Paginas --> ApiClient
Paginas ..> SignalClient : actualizaciones previstas
ApiClient --> Controllers : HTTPS / JSON
SignalClient --> Hub : tiempo real previsto
Controllers --> Services
Services --> EF
Controllers --> Identity
Services --> Worker
Worker --> J0
J0 --> Judge
EF --> DB
Identity --> DB
Worker --> Hub
@enduml
