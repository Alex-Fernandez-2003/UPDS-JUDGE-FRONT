@startuml
left to right direction
skinparam componentStyle rectangle
actor "Visitante / Participante" as User
actor "Administrador de Concursos" as ContestAdmin
actor "Administrador de Roles" as RoleAdmin
rectangle "Frontend UPDS JUDGE\React + Vite + TypeScript" as Front
rectangle "Backend UPDS JUDGE\nASP.NET Core MVC / Web API" as Back
rectangle "PostgreSQL\n+ ASP.NET Core Identity" as DB
cloud "Judge0 API" as Judge
cloud "Google Drive\nPDF de problemas" as Drive
rectangle "SignalR Hub" as Hub
User --> Front
ContestAdmin --> Front
RoleAdmin --> Front
Front --> Back : HTTPS / JSON / JWT
Front --> Hub : conexión en tiempo real
Back --> DB : EF Core
Back --> Judge : evaluación de código
Back --> Drive : almacena/consulta enlace
Back --> Hub : publica cambios de estado
@enduml
